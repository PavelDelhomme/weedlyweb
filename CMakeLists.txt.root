# CMakeLists.txt racine pour monorepo
cmake_minimum_required(VERSION 3.16)
project(WeedlyWeb VERSION 1.0 LANGUAGES CXX)

# C++17 standard
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# Options de build
option(BUILD_UI_GTK "Build GTK UI" ON)
option(BUILD_UI_QT "Build Qt UI" OFF)
option(BUILD_UI_ANDROID "Build Android UI" OFF)

# Répertoires de sortie
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)

# Ajouter le répertoire core
add_subdirectory(core)

# Ajouter les UIs selon les options
if(BUILD_UI_GTK)
    add_subdirectory(ui-gtk)
endif()

if(BUILD_UI_QT)
    add_subdirectory(ui-qt)
endif()

if(BUILD_UI_ANDROID)
    add_subdirectory(ui-android)
endif()

# Installation
install(DIRECTORY assets/ DESTINATION share/WeedlyWeb)

