# CMakeLists.txt pour core/ (bibliothèque indépendante)
cmake_minimum_required(VERSION 3.16)

project(WeedlyWebCore VERSION 1.0 LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# Dépendances core (pas de GUI)
find_package(CURL REQUIRED)
find_package(PkgConfig REQUIRED)
pkg_check_modules(SQLITE3 REQUIRED sqlite3)

# nlohmann/json (header-only)
find_path(NLOHMANN_JSON_INCLUDE_DIR nlohmann/json.hpp
    PATHS
    /usr/include
    /usr/local/include
    ${CMAKE_SOURCE_DIR}/../third_party/nlohmann
)

if(NOT NLOHMANN_JSON_INCLUDE_DIR)
    message(STATUS "nlohmann/json non trouvé, téléchargement...")
    file(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/nlohmann)
    file(DOWNLOAD 
        https://github.com/nlohmann/json/releases/download/v3.11.2/json.hpp
        ${CMAKE_BINARY_DIR}/nlohmann/json.hpp
        TIMEOUT 30
        SHOW_PROGRESS
    )
    set(NLOHMANN_JSON_INCLUDE_DIR ${CMAKE_BINARY_DIR})
endif()

# Sources core
set(CORE_SOURCES
    src/database/Database.cpp
    src/http/HttpManager.cpp
    src/storage/FileManager.cpp
    src/memory/MemoryManager.cpp
    src/favorites/FavoritesManager.cpp
    src/tabs/TabManager.cpp
    src/utils/CVEAnalyzer.cpp
    src/utils/UrlParser.cpp
    src/utils/StringUtils.cpp
    src/browser/BrowserEngine.cpp
)

set(CORE_HEADERS
    include/database/Database.h
    include/http/HttpManager.h
    include/storage/FileManager.h
    include/memory/MemoryManager.h
    include/favorites/FavoritesManager.h
    include/tabs/TabManager.h
    include/utils/CVEAnalyzer.h
    include/utils/UrlParser.h
    include/utils/StringUtils.h
    include/browser/BrowserEngine.h
    include/browser/IWebView.h
    include/browser/IBrowserWindow.h
)

# Créer la bibliothèque core
add_library(WeedlyWebCore STATIC ${CORE_SOURCES} ${CORE_HEADERS})

target_include_directories(WeedlyWebCore PUBLIC
    ${CMAKE_CURRENT_SOURCE_DIR}/include
    ${CURL_INCLUDE_DIRS}
    ${SQLITE3_INCLUDE_DIRS}
    ${NLOHMANN_JSON_INCLUDE_DIR}
)

target_link_libraries(WeedlyWebCore PUBLIC
    ${CURL_LIBRARIES}
    ${SQLITE3_LIBRARIES}
)

# Installation
install(TARGETS WeedlyWebCore
    ARCHIVE DESTINATION lib
    LIBRARY DESTINATION lib
)

install(DIRECTORY include/ DESTINATION include/WeedlyWebCore)

