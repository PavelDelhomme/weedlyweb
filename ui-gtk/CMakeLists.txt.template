# CMakeLists.txt pour ui-gtk/ (Application GTK)
cmake_minimum_required(VERSION 3.16)

project(WeedlyWebGTK VERSION 1.0 LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# Dépendances GTK
find_package(PkgConfig REQUIRED)
pkg_check_modules(WEBKIT2GTK REQUIRED webkit2gtk-4.1)
pkg_check_modules(GTK3 REQUIRED gtk+-3.0)

# Lier avec core
find_library(WEEDLYWEB_CORE WeedlyWebCore
    PATHS ${CMAKE_BINARY_DIR}/../lib
    REQUIRED
)

# Sources GTK
set(GTK_SOURCES
    src/gtk/GtkBrowserWindow.cpp
    src/gtk/GtkWebView.cpp
    src/gtk/GtkTabBar.cpp
    src/gtk/GtkFavoritesBar.cpp
    src/gtk/GtkCommandPalette.cpp
    src/gtk/main.cpp
)

set(GTK_HEADERS
    include/gtk/GtkBrowserWindow.h
    include/gtk/GtkWebView.h
    include/gtk/GtkTabBar.h
    include/gtk/GtkFavoritesBar.h
    include/gtk/GtkCommandPalette.h
)

# Créer l'exécutable GTK
add_executable(WeedlyWebGTK ${GTK_SOURCES} ${GTK_HEADERS})

target_include_directories(WeedlyWebGTK PRIVATE
    ${CMAKE_CURRENT_SOURCE_DIR}/include
    ${WEBKIT2GTK_INCLUDE_DIRS}
    ${GTK3_INCLUDE_DIRS}
    ${CMAKE_SOURCE_DIR}/core/include
)

target_link_libraries(WeedlyWebGTK PRIVATE
    WeedlyWebCore
    ${WEBKIT2GTK_LIBRARIES}
    ${GTK3_LIBRARIES}
)

# Installation
install(TARGETS WeedlyWebGTK RUNTIME DESTINATION bin)

